# Copy this file to .env and replace the placeholders before starting the stack.
# WEATHER_PROJECT_ROOT must be the absolute path to this github-ready directory.
COMPOSE_PROJECT_NAME=weather-data
WEATHER_PROJECT_ROOT=/absolute/path/to/weather-data-project/github-ready

POSTGRES_USER=db_user
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=db

SUPERSET_PORT=8088
SUPERSET_LOG_LEVEL=info
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-local-only-admin-password

# These demo credentials must match postgres/superset_init.sql.
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_USER=superset
DATABASE_PASSWORD=superset
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=superset

EXAMPLES_USER=examples
EXAMPLES_PASSWORD=examples
EXAMPLES_HOST=db
EXAMPLES_PORT=5432
EXAMPLES_DB=examples

REDIS_HOST=redis
REDIS_PORT=6379
SUPERSET_LOAD_EXAMPLES=false
DEV_MODE=false
FLASK_DEBUG=false
SUPERSET_ENV=development
SUPERSET_APP_ROOT=/
SUPERSET_ENABLE_SWAGGER_UI=false
BUILD_SUPERSET_FRONTEND_IN_DOCKER=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PYTHONUNBUFFERED=1
MAPBOX_API_KEY=
